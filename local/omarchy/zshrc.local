# Omarchy theme integration — per-machine override (untracked).
# Sourced last from ~/.zshrc, after p10k's config, so these win.
#
# Omarchy themes the terminal palette itself; p10k named ANSI colors follow
# it on every `omarchy theme set`. Numbered/hex colors in p10k.zsh stay as
# the fallback look on machines without Omarchy.

# Prompt segments: magenta accent — deliberately NOT blue, so the prompt
# stands apart from the blue tmux statusline and herdr tab bar (which follow
# Omarchy's own accent). Still a named ANSI color, so it follows every
# `omarchy theme set`.
typeset -g POWERLEVEL9K_DIR_BACKGROUND=magenta
typeset -g POWERLEVEL9K_DIR_FOREGROUND=black
typeset -g POWERLEVEL9K_DIR_SHORTENED_FOREGROUND=black

# VCS: keep the semantic hues, but let them follow the themed palette
typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND=green
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND=black
typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND=yellow
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND=black
typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND=green
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND=black
typeset -g POWERLEVEL9K_VCS_{STAGED,UNSTAGED,UNTRACKED,CONFLICTED,COMMITS_AHEAD,COMMITS_BEHIND,STASHES,TAG,SHORTENED_BRANCH}_FOREGROUND=black

# Prompt char / status
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND=green
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND=red

# OS icon: magenta to match the dir segment
# (blue would merge with it AND with the tmux/herdr bars)
typeset -g POWERLEVEL9K_OS_ICON_BACKGROUND=magenta
typeset -g POWERLEVEL9K_OS_ICON_FOREGROUND=black
